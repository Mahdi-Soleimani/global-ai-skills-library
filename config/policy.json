{
  "policy_version": "0.3.0",
  "auto_execute_downloaded_scripts": false,
  "follow_symlinks": false,
  "allow_download_from_public_repositories": true,
  "download_requires_live_repository_verification": true,
  "unknown_license": "index_and_allow_selected_upstream_retrieval_with_attribution; public_redistribution_review_separate",
  "unknown_provenance": "review",
  "blocked_labels": [
    "BLOCKED",
    "MALICIOUS",
    "DO_NOT_INSTALL",
    "CRITICAL"
  ],
  "max_file_size_bytes": 10485760,
  "max_skill_size_bytes": 52428800,
  "max_repository_download_bytes": 524288000,
  "store_git_history": false,
  "pin_to_commit_sha": true,
  "hash_algorithm": "sha256",
  "default_download_mode": "skill_folders_only",
  "install_requires_security_approval": true,
  "source_catalog_policy": "include_every_discovered_skill_path_regardless_of_license",
  "third_party_attribution_required": true,
  "claim_exclusive_ownership": false,
  "public_mirror_requires_license_evidence": true,
  "public_mirror_spdx_allowlist": [
    "0BSD",
    "MIT",
    "MIT-0",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Zlib",
    "Unlicense",
    "CC0-1.0",
    "CC-BY-4.0",
    "CC-BY-SA-4.0",
    "MPL-2.0",
    "EPL-1.0",
    "EPL-2.0",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "LGPL-2.1-only",
    "LGPL-2.1-or-later",
    "LGPL-3.0-only",
    "LGPL-3.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "CDDL-1.0",
    "EUPL-1.2",
    "Artistic-2.0",
    "OSL-3.0"
  ],
  "public_mirror_exclusions": [
    "NOASSERTION",
    "NONE",
    "LicenseRef-*",
    "proprietary",
    "unknown",
    "CC-BY-NC-*",
    "CC-BY-ND-*"
  ],
  "collection_policy": "index_all_discovered_skills_and_retrieve_selected_pinned_content_on_demand",
  "collection_requires_license_allowlist": false,
  "collection_storage_scope": "user_local_cache_optional",
  "public_mirror_policy": "separate_distribution_gate; allowlist_and_applicable_license_notice_evidence_required",
  "private_archive_required": false,
  "scheduled_refresh_mode": "source_metadata_only"
}
