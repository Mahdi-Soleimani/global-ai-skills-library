{
  "policy_version": "0.1.0",
  "auto_execute_downloaded_scripts": false,
  "follow_symlinks": false,
  "allow_download_from_public_repositories": true,
  "download_requires_live_repository_verification": true,
  "unknown_license": "keep_in_source_catalog_with_upstream_attribution_and_source_link; do_not_publicly_mirror_content_without_verified_redistribution_rights",
  "unknown_provenance": "review",
  "blocked_labels": [
    "BLOCKED",
    "MALICIOUS",
    "DO_NOT_INSTALL",
    "CRITICAL"
  ],
  "max_file_size_bytes": 10485760,
  "max_skill_size_bytes": 52428800,
  "max_repository_download_bytes": 524288000,
  "store_git_history": false,
  "pin_to_commit_sha": true,
  "hash_algorithm": "sha256",
  "default_download_mode": "skill_folders_only",
  "install_requires_security_approval": true,
  "source_catalog_policy": "include_every_discovered_skill_path_regardless_of_license",
  "third_party_attribution_required": true,
  "claim_exclusive_ownership": false,
  "public_mirror_requires_license_evidence": true,
  "public_mirror_spdx_allowlist": [
    "0BSD",
    "MIT",
    "MIT-0",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Zlib",
    "Unlicense",
    "CC0-1.0",
    "CC-BY-4.0",
    "CC-BY-SA-4.0",
    "MPL-2.0",
    "EPL-1.0",
    "EPL-2.0",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "LGPL-2.1-only",
    "LGPL-2.1-or-later",
    "LGPL-3.0-only",
    "LGPL-3.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "CDDL-1.0",
    "EUPL-1.2",
    "Artistic-2.0",
    "OSL-3.0"
  ],
  "public_mirror_exclusions": [
    "NOASSERTION",
    "NONE",
    "LicenseRef-*",
    "proprietary",
    "unknown",
    "CC-BY-NC-*",
    "CC-BY-ND-*"
  ]
}
